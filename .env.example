# Required to generate practice sets. Keep this on the server.
OPENROUTER_API_KEY=
# Set a long, random value outside local development.
SECRET_KEY=
# Google OAuth web application credentials. Register GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Optional comma-separated allowlist. Leave empty to allow any verified Google account.
ALLOWED_EMAILS=
DAILY_GENERATION_LIMIT=10
# This demo branch enables local-only sample cards. Set false in deployment.
LOCAL_DEMO_MODE=true
# Optional settings
OPENROUTER_MODEL=google/gemini-2.5-flash
PRACTICE_DB_PATH=practice.sqlite3
FRONTEND_ORIGIN=http://localhost:5173
PORT=5001
COOKIE_SECURE=false
